{
  "name": "itsgonein-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n emu,api,web \"npm:dev:emulators\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "FOOTBALL_DATA_MOCK=1 FIREBASE_PROJECT_ID=demo-itgonein FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 ADMIN_EMAILS=tm@solumre.com node --watch server/index.js",
    "dev:emulators": "npx -y firebase-tools@14 emulators:start --only auth,firestore --project demo-itgonein",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:emulator": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-itgonein \"vitest run tests/emulator --no-file-parallelism\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.61.0",
    "obscenity": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
